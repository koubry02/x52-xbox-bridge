[Unit]
Description=HOTAS Bridge – Oberon WebSocket server (X52 -> Xbox, single-Pi mode)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/hotas-bridge/oberon
# No --config: the server runs in LAYOUTS mode, reading /opt/hotas-bridge/layouts
# and starting on whichever layout was last active. The throttle's layout-switch
# button cycles games live; the web app (port 8088) edits them.
# To pin one fixed config the old way, add:  --config /opt/hotas-bridge/sender/sender_config.json
ExecStart=/usr/bin/python3 /opt/hotas-bridge/oberon/oberon_server.py \
    --layouts-dir /opt/hotas-bridge/layouts \
    --menu
Restart=always
RestartSec=3
# Give the reader higher priority so evdev reads don't miss events under load.
# We use Nice (always permitted) instead of a real-time scheduler:
# CPUSchedulingPolicy=fifo needs RT privileges the Pi often denies, which
# fails with status=214/SETSCHEDULER and crash-loops the service.
Nice=-10

[Install]
WantedBy=multi-user.target
